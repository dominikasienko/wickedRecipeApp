    "Macro amounts are broad acceptable ranges, not exact personal prescriptions. Diet preferences and weight goal do not change these physiological estimates." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makronährstoffmengen sind breite akzeptable Bereiche, keine exakten persönlichen Vorgaben. Ernährungspräferenzen und Gewichtsziele verändern diese physiologischen Schätzungen nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cantidades de macronutrientes son intervalos amplios aceptables, no prescripciones personales exactas. Las preferencias dietéticas y el objetivo de peso no modifican estas estimaciones fisiológicas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les quantités de macronutriments sont des plages acceptables générales, pas des prescriptions personnelles exactes. Les préférences alimentaires et l’objectif de poids ne modifient pas ces estimations physiologiques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le quantità di macronutrienti sono ampi intervalli accettabili, non prescrizioni personali esatte. Preferenze alimentari e obiettivo di peso non modificano queste stime fisiologiche."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilości makroskładników to szerokie akceptowalne zakresy, a nie dokładne indywidualne zalecenia. Preferencje żywieniowe i cel masy ciała nie zmieniają tych szacunków fizjologicznych."
          }
        }
      }
    },
