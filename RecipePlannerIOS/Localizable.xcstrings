          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recette n’a pas pu être enregistrée. Vérifiez votre connexion ou vos autorisations."
          }
        },
        "it" : {
          "stringUnit" : {
