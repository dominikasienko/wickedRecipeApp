    "Your account and associated data will be permanently removed. If sign-in cannot be verified, deletion will not start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und die zugehörigen Daten werden dauerhaft gelöscht. Wenn die Anmeldung nicht bestätigt werden kann, wird die Löschung nicht gestartet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and associated data will be permanently removed. If sign-in cannot be verified, deletion will not start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y los datos asociados se eliminarán permanentemente. Si no se puede verificar el inicio de sesión, no comenzará la eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte et les données associées seront supprimés définitivement. Si la connexion ne peut pas être vérifiée, la suppression ne commencera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account e i dati associati saranno eliminati definitivamente. Se non è possibile verificare l’accesso, l’eliminazione non verrà avviata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto i powiązane dane zostaną trwale usunięte. Jeśli nie uda się zweryfikować logowania, usuwanie się nie rozpocznie."
          }
        }
      }
    },
    "Your personal data was removed, but the sign-in account could not be deleted. Please contact support." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine persönlichen Daten wurden entfernt, aber das Anmeldekonto konnte nicht gelöscht werden. Bitte wende dich an den Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your personal data was removed, but the sign-in account could not be deleted. Please contact support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron tus datos personales, pero no se pudo eliminar la cuenta de acceso. Contacta con soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données personnelles ont été supprimées, mais le compte de connexion n’a pas pu être supprimé. Contactez l’assistance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati personali sono stati rimossi, ma non è stato possibile eliminare l’account di accesso. Contatta l’assistenza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane osobowe zostały usunięte, ale nie udało się usunąć konta logowania. Skontaktuj się z pomocą."
          }
        }
      }
    },
