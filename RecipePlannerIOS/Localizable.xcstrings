    "Health profile data is required for personalized estimates. To withdraw consent and remove this data, delete your account." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesundheitsprofildaten werden für personalisierte Schätzungen benötigt. Um die Einwilligung zu widerrufen und diese Daten zu entfernen, lösche dein Konto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health profile data is required for personalized estimates. To withdraw consent and remove this data, delete your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del perfil de salud son necesarios para las estimaciones personalizadas. Para retirar el consentimiento y eliminar estos datos, borra tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données du profil de santé sont nécessaires aux estimations personnalisées. Pour retirer votre consentement et supprimer ces données, supprimez votre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati del profilo sanitario servono per le stime personalizzate. Per revocare il consenso e rimuovere questi dati, elimina l’account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane profilu zdrowotnego są potrzebne do spersonalizowanych szacunków. Aby wycofać zgodę i usunąć te dane, usuń konto."
          }
        }
      }
    },
