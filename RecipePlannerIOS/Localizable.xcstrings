    "The energy equation uses male or female reference categories. No equation is applied to Other." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Energiegleichung verwendet männliche oder weibliche Referenzkategorien. Für „Andere“ wird keine Gleichung angewendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ecuación energética utiliza categorías de referencia masculina o femenina. No se aplica ninguna ecuación a «Otra»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’équation énergétique utilise les catégories de référence masculine ou féminine. Aucune équation n’est appliquée à « Autre »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’equazione energetica usa categorie di riferimento maschili o femminili. Non viene applicata alcuna equazione a «Altro»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równanie energetyczne korzysta z męskiej lub kobiecej kategorii odniesienia. Dla opcji „Inna” nie stosuje się równania."
          }
        }
      }
    },
    "The file contains your personal and health data. Store it in a safe place." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei enthält deine personenbezogenen Gesundheitsdaten. Bewahre sie an einem sicheren Ort auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file contains your personal and health data. Store it in a safe place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo contiene tus datos personales y de salud. Guárdalo en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier contient vos données personnelles et de santé. Conservez-le en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file contiene i tuoi dati personali e sanitari. Conservalo in un luogo sicuro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik zawiera Twoje dane osobowe i dane o zdrowiu. Zapisz go w bezpiecznym miejscu."
          }
        }
      }
    },
    "The NASEM equations were developed for U.S. and Canadian populations and have not been calibrated specifically for Polish users. Activity categories describe the whole day, not workout count." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die NASEM-Gleichungen wurden für US-amerikanische und kanadische Bevölkerungsgruppen entwickelt und nicht speziell für Polen kalibriert. Aktivitätskategorien beschreiben den gesamten Tag, nicht die Anzahl der Trainingseinheiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ecuaciones NASEM se desarrollaron para poblaciones de EE. UU. y Canadá y no se han calibrado específicamente para usuarios polacos. Las categorías describen la actividad diaria total, no el número de entrenamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les équations NASEM ont été conçues pour les populations des États-Unis et du Canada et ne sont pas calibrées spécifiquement pour la Pologne. Les catégories décrivent toute la journée, pas le nombre d’entraînements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le equazioni NASEM sono state sviluppate per popolazioni statunitensi e canadesi e non sono calibrate specificamente per la Polonia. Le categorie descrivono l’intera giornata, non il numero di allenamenti."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Równania NASEM opracowano dla populacji USA i Kanady i nie kalibrowano ich specjalnie dla Polski. Kategorie aktywności opisują cały dzień, a nie liczbę treningów."
          }
        }
      }
    },
    "The operation could not be completed. Please try again later." : {
      "comment" : "An error message displayed when an unexpected error occurs while saving a recipe.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
