    "Review your age, measurements, activity and dietary preferences. General estimates stay disabled until you check your profile and enable them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe dein Alter, deine Messwerte, Aktivität und Ernährungspräferenzen. Allgemeine Schätzungen bleiben deaktiviert, bis du dein Profil geprüft und sie aktiviert hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review your age, measurements, activity and dietary preferences. General estimates stay disabled until you check your profile and enable them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tu edad, medidas, actividad y preferencias alimentarias. Las estimaciones generales seguirán desactivadas hasta que revises tu perfil y las actives."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre âge, vos mesures, votre activité et vos préférences alimentaires. Les estimations générales restent désactivées jusqu’à la vérification de votre profil et leur activation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla età, misure, attività e preferenze alimentari. Le stime generali restano disattivate finché non verifichi il profilo e le attivi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź wiek, pomiary, aktywność i preferencje żywieniowe. Ogólne szacunki pozostaną wyłączone, dopóki nie sprawdzisz profilu i ich nie włączysz."
          }
        }
      }
    },
