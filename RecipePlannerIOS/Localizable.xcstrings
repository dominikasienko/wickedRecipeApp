    "EFSA water values are adequate intakes of total water from all beverages and food moisture under moderate conditions. This app logs beverages only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die EFSA-Werte beziehen sich auf die Gesamtwasseraufnahme aus Getränken und Lebensmitteln unter moderaten Bedingungen. Diese App erfasst nur Getränke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores de la EFSA son ingestas adecuadas de agua total procedente de bebidas y alimentos en condiciones moderadas. Esta app registra solo bebidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs EFSA concernent l’apport total en eau des boissons et des aliments dans des conditions modérées. Cette app ne suit que les boissons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I valori EFSA indicano l’apporto adeguato di acqua totale da bevande e alimenti in condizioni moderate. Questa app registra solo le bevande."
          }
        },
        "pl" : {
          "stringUnit" : {
