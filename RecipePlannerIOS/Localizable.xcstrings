    "Some account data could not be removed. Your sign-in account remains active; contact support before retrying." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Kontodaten konnten nicht entfernt werden. Dein Anmeldekonto bleibt aktiv. Wende dich vor einem erneuten Versuch an den Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some account data could not be removed. Your sign-in account remains active; contact support before retrying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron eliminar algunos datos. La cuenta de acceso sigue activa; contacta con soporte antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données du compte n’ont pas pu être supprimées. Le compte de connexion reste actif ; contactez l’assistance avant de réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile rimuovere alcuni dati. L’account di accesso è ancora attivo; contatta l’assistenza prima di riprovare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się usunąć części danych. Konto logowania pozostaje aktywne; przed ponowną próbą skontaktuj się z pomocą."
          }
        }
      }
    },
    "Some account data could not be removed. Your sign-in account remains active; some data may already have been removed. Retry or contact support." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Kontodaten konnten nicht entfernt werden. Dein Anmeldekonto bleibt aktiv; möglicherweise wurden bereits Daten gelöscht. Versuche es erneut oder wende dich an den Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some account data could not be removed. Your sign-in account remains active; some data may already have been removed. Retry or contact support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron eliminar algunos datos. La cuenta de acceso sigue activa; es posible que ya se hayan eliminado algunos datos. Inténtalo de nuevo o contacta con soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données n’ont pas pu être supprimées. Le compte reste actif ; certaines données ont peut-être déjà été supprimées. Réessayez ou contactez l’assistance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile rimuovere alcuni dati. L’account resta attivo; alcuni dati potrebbero essere già stati eliminati. Riprova o contatta l’assistenza."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się usunąć części danych. Konto logowania pozostaje aktywne; część danych mogła już zostać usunięta. Spróbuj ponownie lub skontaktuj się z pomocą."
          }
        }
      }
    },
    "Some ingredients were not matched. Values are based on available data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Zutaten konnten nicht zugeordnet werden. Die Werte basieren auf den verfügbaren Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontraron algunos ingredientes. Los valores se basan en los datos disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains ingrédients n’ont pas été trouvés. Les valeurs sont basées sur les données disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni ingredienti non sono stati trovati. I valori si basano sui dati disponibili."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niektóre składniki nie zostały dopasowane. Wartości oparto na dostępnych danych."
          }
        }
      }
    },
    "Some recipes were deleted, but image cleanup also failed. The remaining recipes are still selected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Rezepte wurden gelöscht, aber auch das Entfernen der Bilder ist fehlgeschlagen. Die übrigen Rezepte bleiben ausgewählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron algunas recetas, pero también falló la limpieza de imágenes. El resto de las recetas sigue seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines recettes ont été supprimées, mais le nettoyage des images a également échoué. Les autres recettes restent sélectionnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune ricette sono state eliminate, ma è fallita anche la rimozione delle immagini. Le ricette rimanenti restano selezionate."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część przepisów została usunięta, ale nie udało się też usunąć zdjęć. Pozostałe przepisy nadal są zaznaczone."
          }
        }
      }
    },
    "Some recipes were deleted, but the remaining selection could not be deleted. Check your connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Rezepte wurden gelöscht, aber die übrige Auswahl konnte nicht gelöscht werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron algunas recetas, pero no se pudo eliminar el resto de la selección. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines recettes ont été supprimées, mais le reste de la sélection n’a pas pu l’être. Vérifiez votre connexion et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune ricette sono state eliminate, ma non è stato possibile eliminare il resto della selezione. Controlla la connessione e riprova."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Część przepisów została usunięta, ale nie udało się usunąć pozostałych. Sprawdź połączenie i spróbuj ponownie."
          }
        }
      }
    },
