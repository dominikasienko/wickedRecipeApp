          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los objetivos precisos de calorías e hidratación solo se usan cuando los datos de salud y dieta requeridos están completos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
