          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri un mese per vedere quali prodotti sono più freschi in questo momento e pianifica ricette con ingredienti naturalmente di stagione."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz miesiąc, aby zobaczyć, co jest teraz najświeższe, i planuj przepisy z produktów naturalnie dostępnych w sezonie."
          }
