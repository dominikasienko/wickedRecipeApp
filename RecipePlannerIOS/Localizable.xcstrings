    "The recipe could not be deleted. Check your connection and try again." : {

    },
    "The recipe could not be saved. Check your connection or permissions." : {
      "comment" : "An alert message displayed when an error occurs while saving a recipe. The message instructs the user to check their connection or permissions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Rezept konnte nicht gespeichert werden. Überprüfe deine Verbindung oder Berechtigungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
