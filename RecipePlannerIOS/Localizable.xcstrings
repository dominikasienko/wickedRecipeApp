    "Open a month to see what is freshest right now and plan recipes around produce that is naturally in season." : {
      "comment" : "A description of the seasonal calendar view, encouraging users to explore different months and plan meals based on seasonal produce.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
