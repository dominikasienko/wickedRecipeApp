    "EFSA adequate intakes are total water from all beverages and food moisture. This tracker counts only drinks you log." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die EFSA-Richtwerte umfassen Wasser aus allen Getränken und den Wasseranteil von Lebensmitteln. Dieser Tracker zählt nur eingetragene Getränke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ingestas adecuadas de la EFSA incluyen el agua de todas las bebidas y la humedad de los alimentos. Este registro cuenta solo las bebidas anotadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apports adéquats de l’EFSA incluent l’eau de toutes les boissons et l’humidité des aliments. Ce suivi ne compte que les boissons saisies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli apporti adeguati EFSA comprendono l’acqua di tutte le bevande e quella contenuta negli alimenti. Questo tracker conta solo le bevande registrate."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości EFSA obejmują wodę ze wszystkich napojów oraz wilgoć z żywności. Ten moduł zlicza tylko zapisane napoje."
          }
        }
      }
    },
