    "Accurate calorie and hydration targets are only used when required health and diet data are complete." : {
      "comment" : "A description below the \"Health & Goals\" section that explains the use of accurate calorie and hydration targets.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genaue Kalorien- und Hydrationsziele werden nur verwendet, wenn erforderliche Gesundheits- und Ernährungsdaten vollständig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
