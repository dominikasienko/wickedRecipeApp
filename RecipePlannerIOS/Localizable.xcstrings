    "Before the app processes health information, please confirm your age and give explicit consent. You can sign out or delete your account instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor die App Gesundheitsdaten verarbeitet, bestätige bitte dein Alter und erteile deine ausdrückliche Einwilligung. Du kannst dich stattdessen abmelden oder dein Konto löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before the app processes health information, please confirm your age and give explicit consent. You can sign out or delete your account instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de que la app trate información de salud, confirma tu edad y da tu consentimiento explícito. También puedes cerrar sesión o eliminar tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant le traitement de données de santé, confirmez votre âge et donnez votre consentement explicite. Vous pouvez aussi vous déconnecter ou supprimer votre compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima che l’app elabori dati sulla salute, conferma la tua età e presta il consenso esplicito. In alternativa, puoi uscire o eliminare l’account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim aplikacja przetworzy dane o zdrowiu, potwierdź wiek i wyraź zgodę. Możesz też się wylogować lub usunąć konto."
          }
        }
      }
    },
