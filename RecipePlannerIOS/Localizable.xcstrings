      }
    },
    "This will permanently remove all your data (profile, recipes, water logs). This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle deine Daten (Profil, Rezepte, Wasseraufzeichnungen) dauerhaft gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
