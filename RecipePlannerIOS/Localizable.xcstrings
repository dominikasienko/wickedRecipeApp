    "Tea, coffee, and orange juice had short-term hydration similar to water." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee, Kaffee und Orangensaft zeigten kurzfristig eine ahnliche Hydration wie Wasser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El te, el cafe y el zumo de naranja mostraron una hidratacion a corto plazo similar al agua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le the, le cafe et le jus d'orange ont montre une hydratation a court terme similaire a l'eau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te, caffe e succo d'arancia hanno mostrato un'idratazione a breve termine simile all'acqua."
