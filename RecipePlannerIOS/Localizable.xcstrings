          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre un mes para ver qué está más fresco en este momento y planifica recetas con productos que están naturalmente de temporada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
