          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać przepisu. Sprawdź połączenie lub uprawnienia."
          }
        }
      }
    },
    "The recipe was deleted, but its image could not be removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Rezept wurde gelöscht, aber sein Bild konnte nicht entfernt werden."
          }
